# ============================================================================
# Docker Environment Variables - Use for local development and containers
# ============================================================================

# ============================================================================
# Container Configuration
# ============================================================================
BUNDLE=proposicoes
RUN_ID=docker-compose-run
DEBUG_MODE=false

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=camara_data

# PostgreSQL Connection (from extractors perspective)
RDS_ENABLED=true
RDS_HOST=postgres
RDS_PORT=5432
RDS_DATABASE=camara_data
RDS_USER=admin
RDS_PASSWORD=dev_password

# ============================================================================
# S3 Configuration (Local with LocalStack or Real AWS)
# ============================================================================
# For Local Development (using LocalStack):
AWS_ENDPOINT_URL_S3=http://localstack:4566
S3_BUCKET=camera-data-local

# For Production (real AWS):
# AWS_ENDPOINT_URL_S3=  (leave empty or comment out)
# S3_BUCKET=my-production-bucket
# AWS_REGION=us-east-1

# ============================================================================
# AWS Credentials (Local Testing Only)
# ============================================================================
# For local development with LocalStack - use test credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# For Production - DO NOT COMMIT REAL CREDENTIALS
# Use AWS IAM roles, Secrets Manager, or environment variables instead
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================================================
# Data Extraction Configuration
# ============================================================================
# Legislatura inicial para backfill
INIT_LEGISLATURA=56

# Itens por página na API Câmara
API_ITEMS_PER_PAGE=100

# Máximo de tentativas de retry
API_MAX_RETRIES=7

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ============================================================================
# Feature Flags (Development)
# ============================================================================
SAVE_LOCAL_COPY=false
LOCAL_DATA_PATH=/tmp/camara-data

# ============================================================================
# Notification Configuration (Optional)
# ============================================================================
NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL=seu-email@example.com
